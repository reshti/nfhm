# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration (for cPanel MySQL / MariaDB / PostgreSQL)
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nafham_db
DB_USER=nafham_user
DB_PASSWORD=your_password_here
DB_PREFIX=nf_
PORT=3000
NODE_ENV=production

